# StageCraft Cloud configuration (validated at startup; every problem is listed, then the process exits with code 2).
# Development defaults are shown; production (NODE_ENV=production) refuses AUTH_MODE=dev, PAYMENT_PROVIDER=fake,
# BLOB_STORE=local, SQLite, http PUBLIC_BASE_URL / S3_ENDPOINT and a missing STRIPE_WEBHOOK_SECRETS.

# production | development | test
NODE_ENV=development
PORT=8080
# https in production; used for verification, return and download URLs
PUBLIC_BASE_URL=http://localhost:8080
# debug | info | warn | error
LOG_LEVEL=info
# 1 behind the AWS ALB: the client IP is the last X-Forwarded-For entry
TRUST_PROXY_HOPS=0

# Database: DATABASE_URL (Postgres) wins; otherwise SQLite at SQLITE_PATH (development only).
DATABASE_URL=
DATABASE_MAX_CONNECTIONS=10
SQLITE_PATH=./data/stagecraft-cloud.sqlite
# default false in production: run `node src/cli.ts migrate` (the k8s Job) instead
MIGRATE_ON_START=true

# Sign-in (ADR 0032 §5, D6)
# oidc | dev   (dev = type any user name on the verify page; never in production)
AUTH_MODE=dev
# e.g. https://cognito-idp.us-east-1.amazonaws.com/us-east-1_XXXX
OIDC_ISSUER=
OIDC_CLIENT_ID=
# optional (public clients use PKCE only)
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid email profile

# Payments (ADR 0032 §3, D1-D4)
# stripe | fake
PAYMENT_PROVIDER=fake
# sk_test_... / sk_live_... or a restricted rk_ key
STRIPE_SECRET_KEY=
# comma-separated: platform endpoint, Connect endpoint, and old secrets during rotation
STRIPE_WEBHOOK_SECRETS=whsec_dev_only_secret
STRIPE_API_BASE=https://api.stripe.com
# pin the API version the webhook endpoint uses (recommended)
STRIPE_API_VERSION=
# D3
STRIPE_AUTOMATIC_TAX=false
# D1: US or GB
STRIPE_PLATFORM_COUNTRY=US
# default ${PUBLIC_BASE_URL}/checkout/success
CHECKOUT_SUCCESS_URL=
# default ${PUBLIC_BASE_URL}/checkout/cancel
CHECKOUT_CANCEL_URL=
# Stripe allows 30..1440; the client waits this plus one minute
CHECKOUT_EXPIRES_MINUTES=30
SETTLEMENT_CURRENCIES=USD
# 85 % to the seller; stored on each order at creation
SELLER_SHARE_BPS=8500
# D5
PAYOUT_HOLD_DAYS=14
PAYOUT_MINIMUM_MINOR=100
# used only when a lost dispute carries no fee in its balance transactions
DISPUTE_FEE_FALLBACK_MINOR=1500

# Package, thumbnail and screenshot storage
# s3 | local
BLOB_STORE=local
BLOB_LOCAL_DIR=./data/blobs
# signs local download URLs (>= 16 characters)
BLOB_URL_SECRET=dev-only-blob-url-secret
S3_BUCKET=
S3_REGION=
# only for S3-compatible stores (path style); https in production
S3_ENDPOINT=
S3_PREFIX=
# 5-minute pre-signed downloads
DOWNLOAD_URL_TTL_SECONDS=300
# AWS credentials: EKS Pod Identity or IRSA are picked up automatically; static keys only for local testing.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
